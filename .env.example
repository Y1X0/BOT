# ==========================================================================
# Telegram Group Bot — environment configuration
# Copy this file to `.env` and fill in the values. NEVER commit your real .env.
# ==========================================================================

# --- Required ---------------------------------------------------------------
# Get a token from @BotFather on Telegram.
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyz
# Your bot's @username (without the @). Optional but recommended.
BOT_USERNAME=my_group_bot

# Comma-separated Telegram user IDs with global owner privileges.
# Get your ID by sending /id to the bot.
OWNER_IDS=123456789

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# Bot mode: "polling" (simplest, good for local dev) or "webhook" (best on Render).
BOT_MODE=polling

# Only needed when BOT_MODE=webhook:
# WEBHOOK_DOMAIN=https://your-service.onrender.com
# WEBHOOK_PATH=/telegraf
# WEBHOOK_SECRET=a-long-random-string

# --- Database ---------------------------------------------------------------
# SQLite (default, zero-config):
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./data/bot.db

# PostgreSQL (production / Render Postgres) — switch both lines:
# DATABASE_PROVIDER=postgresql
# DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public

# --- Localization -----------------------------------------------------------
DEFAULT_LANGUAGE=ar
DEFAULT_TIMEZONE=Asia/Riyadh

# --- Optional: Weather (OpenWeatherMap) -------------------------------------
# WEATHER_API_KEY=your_openweathermap_key

# --- Optional: AI assistant -------------------------------------------------
AI_ENABLED=false
AI_PROVIDER=anthropic
# AI_API_KEY=sk-...
AI_MODEL=claude-haiku-4-5-20251001
AI_DAILY_LIMIT=50

# --- Rate limiting (command throttle per user) ------------------------------
RATE_LIMIT_WINDOW_MS=2000
RATE_LIMIT_MAX=5

# --- Web dashboard (opt-in) -------------------------------------------------
# Owner-only control panel at /dashboard, login via Telegram widget.
# Requires BOT_USERNAME set AND the public domain registered in BotFather
# (/setdomain → your Render/Railway URL) for the login widget to work.
DASHBOARD_ENABLED=false
# DASHBOARD_SECRET=a-long-random-string   # optional; derived from BOT_TOKEN if unset

# --- YouTube audio (يوت / /yt) ----------------------------------------------
# Requires yt-dlp + ffmpeg on the host (installed by the Dockerfile).
YT_ENABLED=true
# YTDLP_PATH=yt-dlp
# Limits: 0 = unlimited. (Telegram still caps bot sends at ~50MB unless you
# run a local Bot API server.) All are adjustable live via /ytset.
YT_MAX_DURATION_SEC=0
YT_MAX_SIZE_MB=0
YT_MAX_RESULTS=10
YT_CONCURRENCY_PER_GROUP=1
# YouTube blocks datacenter IPs ("confirm you're not a bot"). Fix by pasting
# your exported youtube.com cookies.txt content here (keep it SECRET):
# YT_COOKIES="# Netscape HTTP Cookie File\n.youtube.com\tTRUE\t/\t...."
# or point to a file: YT_COOKIES_FILE=/app/data/cookies.txt
# Optional player client to try: android | web_safari | tv | ios
# YT_PLAYER_CLIENT=
YT_FORCE_IPV4=true
