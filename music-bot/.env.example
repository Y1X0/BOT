# انسخ هذا الملف إلى .env وعبّي القيم.
# هذه الخدمة ما بتاخد توكن بوت — بس بتربط الحساب المساعد. بوت الإدارة هو اللي بيتحكّم فيها.

# من https://my.telegram.org (API development tools)
API_ID=1234567
API_HASH=your_api_hash_here

# جلسة الحساب المساعد — ولّدها بأمر: python gen_session.py
SESSION_STRING=paste_the_generated_session_string_here

# كلمة سر مشتركة بين بوت الإدارة وهذه الخدمة (نفس القيمة تنحط ببوت الإدارة كـ STREAMER_TOKEN)
STREAMER_TOKEN=choose_a_long_random_secret

# منفذ HTTP (اتركه 8080 عادةً)
PORT=8080

# (اختياري) ثواني انتظار قبل ربط الحساب المساعد عند الإقلاع (أمان إعادة النشر)
# الافتراضي 25. لا تشغّل نسختين بنفس SESSION_STRING (AUTH_KEY_DUPLICATED).
# STREAMER_START_DELAY=25

# (اختياري) رابط البوت العام عشان يوصله إشعار الأغنية التالية تلقائياً فيعرض البطاقة.
# BOT_CALLBACK_URL=https://your-bot.up.railway.app/vc/nowplaying
