// Prisma schema — SQLite by default, portable to PostgreSQL.
// To switch to PostgreSQL: set provider = "postgresql" and DATABASE_URL accordingly.
// Enum-like fields are stored as String for cross-DB portability (SQLite has no enums).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Provider is set at build time by scripts/set-db-provider.mjs based on the
  // DATABASE_PROVIDER env var (Prisma forbids env() here). Default: sqlite.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A Telegram chat (group / supergroup) the bot has been added to.
model Chat {
  id             BigInt    @id // Telegram chat id
  title          String?
  type           String    @default("group")
  language       String    @default("ar")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  settings       ChatSettings?
  members        Member[]
  warnings       Warning[]
  replies        CustomReply[]
  filters        WordFilter[]
  auditLogs      AuditLog[]
  economy        EconomyAccount[]
  notes          Note[]

  @@index([type])
}

/// Per-chat configuration. One row per chat.
model ChatSettings {
  chatId              BigInt   @id
  chat                Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  // Welcome / farewell
  welcomeEnabled      Boolean  @default(true)
  welcomeMessage      String?  // supports {name} {title} {count} placeholders
  welcomeImageUrl     String?
  farewellEnabled     Boolean  @default(false)
  farewellMessage     String?
  captchaEnabled      Boolean  @default(false)
  captchaTimeoutSec   Int      @default(120)

  // Anti-spam / moderation
  antispamEnabled     Boolean  @default(true)
  floodEnabled        Boolean  @default(true)
  floodLimit          Int      @default(7)   // messages
  floodWindowSec      Int      @default(10)  // per window
  antiLinkEnabled     Boolean  @default(false)
  antiForwardEnabled  Boolean  @default(false)
  filtersEnabled      Boolean  @default(true)
  badwordsEnabled     Boolean  @default(false) // auto-filter Arabic profanity/insults
  maxWarnings         Int      @default(3)
  warnAction          String   @default("mute") // mute | kick | ban

  // Fun / engagement
  repliesEnabled      Boolean  @default(true)
  reactionsEnabled    Boolean  @default(true)
  gamesEnabled        Boolean  @default(true)
  economyEnabled      Boolean  @default(true)
  xpEnabled           Boolean  @default(true)

  // AI
  aiEnabled           Boolean  @default(false)

  // Night mode (auto lock/unlock by hour) + service-message cleanup
  nightModeEnabled    Boolean  @default(false)
  nightStartHour      Int      @default(0)
  nightEndHour        Int      @default(6)
  cleanServiceEnabled Boolean  @default(false)

  // Anti-raid: detect sudden mass joins and lock the group
  antiRaidEnabled     Boolean  @default(false)

  // Weekly auto-report
  weeklyReportEnabled Boolean  @default(false)
  lastWeeklyReportAt  DateTime?

  // Question of the day
  qotdEnabled         Boolean  @default(false)
  lastQotdAt          DateTime?

  // Automatic morning/evening athkar
  athkarEnabled       Boolean  @default(true)
  lastAthkarSlot      String?  // "YYYY-MM-DD:m" or ":e" — de-dupes sends

  // Daily ayah + tafsir
  dailyAyahEnabled    Boolean  @default(true)
  lastDailyAyah       String?  // "YYYY-MM-DD" — de-dupes daily send

  // Prayer-time announcements (on by default; city defaults to Amman,Jordan)
  prayerNotifyEnabled Boolean  @default(true)
  prayerCity          String?  // e.g. "Amman,Jordan" (defaults applied in code)
  lastPrayerAnnounced String?  // "YYYY-MM-DD:Dhuhr" — de-dupes per prayer

  // AI moderation
  moderationEnabled   Boolean  @default(false)
  moderationAction    String   @default("delete") // delete | warn | mute | ban

  // Rules
  rules               String?

  // Custom "id" card: a template with {placeholders} + optional premium-emoji entities
  idCardTemplate      String?
  idCardEntities      String? // JSON of Telegram entities captured with the template
  idCardImage         Boolean  @default(true) // render the card as a designed image (else text)
  idCardTheme         String   @default("auto") // color theme: auto | random | <theme id>

  updatedAt           DateTime @updatedAt
}

/// A user's membership + stats inside a specific chat.
model Member {
  id           Int      @id @default(autoincrement())
  chatId       BigInt
  userId       BigInt
  chat         Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  username     String?
  firstName    String?
  role         String   @default("member") // owner | admin | moderator | member
  messageCount Int      @default(0)
  weeklyMessages Int    @default(0) // reset when the weekly report is posted
  xp           Int      @default(0)
  level        Int      @default(0)
  gamesWon     Int      @default(0)
  rep          Int      @default(0) // reputation / thanks points
  title        String?  // equipped shop title, e.g. "👑 ملك الجروب"
  afkSince     DateTime? // set when the user goes AFK, null otherwise
  afkReason    String?
  birthDay     Int?      // 1-31
  birthMonth   Int?      // 1-12
  partnerId    BigInt?   // in-group "marriage" partner (fun feature)
  marriedAt    DateTime?
  lastSeenAt   DateTime @default(now())
  joinedAt     DateTime @default(now())

  @@unique([chatId, userId])
  @@index([chatId, xp])
  @@index([chatId, messageCount])
}

/// In-group economy account (coins) per user per chat.
model EconomyAccount {
  id          Int      @id @default(autoincrement())
  chatId      BigInt
  userId      BigInt
  chat        Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  balance     Int      @default(0)
  bank        Int      @default(0) // safe from robbery
  lastDailyAt DateTime?
  lastRobAt   DateTime?
  lastWorkAt  DateTime?
  lastCrimeAt DateTime?

  @@unique([chatId, userId])
  @@index([chatId, balance])
}

/// Moderation warnings issued to a user in a chat.
model Warning {
  id        Int      @id @default(autoincrement())
  chatId    BigInt
  userId    BigInt
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  reason    String?
  issuedBy  BigInt
  createdAt DateTime @default(now())

  @@index([chatId, userId])
}

/// Admin-defined keyword -> response(s). Multiple responses = random pick.
model CustomReply {
  id        Int      @id @default(autoincrement())
  chatId    BigInt
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  trigger   String
  responses String   // JSON string array
  entities  String? // JSON of Telegram message entities (for premium/custom-emoji replies)
  matchType String   @default("contains") // exact | contains | regex
  createdBy BigInt
  createdAt DateTime @default(now())

  @@unique([chatId, trigger])
  @@index([chatId])
}

/// Banned words per chat.
model WordFilter {
  id        Int      @id @default(autoincrement())
  chatId    BigInt
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  word      String
  action    String   @default("delete") // delete | warn | mute
  createdAt DateTime @default(now())

  @@unique([chatId, word])
  @@index([chatId])
}

/// Saved notes: admin-stored text retrievable by name or #hashtag.
model Note {
  id        Int      @id @default(autoincrement())
  chatId    BigInt
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  name      String
  content   String
  createdBy BigInt
  createdAt DateTime @default(now())

  @@unique([chatId, name])
  @@index([chatId])
}

/// Logged message metadata (opt-in via MESSAGE_LOG_ENABLED). Powers the
/// owner dashboard's monitor, media viewer, logs, search, and analytics.
model MessageLog {
  id        Int      @id @default(autoincrement())
  chatId    BigInt
  chatTitle String?
  userId    BigInt
  userName  String?
  messageId Int
  type      String // text|photo|video|audio|voice|animation|sticker|document|location|contact|edit|other
  text      String?
  fileId    String?
  flagged   Boolean  @default(false) // set by AI moderation
  outgoing  Boolean  @default(false) // true = message sent BY the bot
  replyToName String? // display name of the user this message replied to (if any)
  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
  @@index([userId])
  @@index([type])
  @@index([flagged])
}

/// Simple key/value store for one-time migrations & app-wide flags.
model AppState {
  key   String @id
  value String
}

/// Anonymous "musaraha" messages (persisted for reply routing + owner oversight).
model MusarahaMessage {
  id             Int      @id @default(autoincrement())
  senderId       BigInt
  senderName     String?
  recipientId    BigInt
  text           String
  deliveredMsgId Int? // message_id in the recipient's DM (for native replies)
  isReply        Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([recipientId, deliveredMsgId])
  @@index([createdAt])
}

/// A secret whisper (همسة) posted to a group, kept for owner oversight —
/// who whispered, to whom, in which group, and the hidden content.
model WhisperMessage {
  id         Int      @id @default(autoincrement())
  senderId   BigInt
  senderName String?
  targetId   BigInt
  targetName String?
  chatId     BigInt
  chatTitle  String?
  text       String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Bot-wide key/value settings set by the bot owner (e.g. a global id-card
/// template that applies to every group unless a group overrides it).
model GlobalConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// A custom bot rank assigned to a user in a chat (independent of Telegram's
/// own admin status). Grants bot-command permissions to whoever holds it.
model ChatRole {
  chatId     BigInt
  userId     BigInt
  role       String // admin | moderator | vip
  name       String? // display name at assignment time (for the /roles list)
  assignedBy BigInt?
  createdAt  DateTime @default(now())

  @@id([chatId, userId])
  @@index([chatId])
}

/// A user's personal sticker set created through the bot.
model StickerPack {
  userId    BigInt
  kind      String   @default("regular") // regular | emoji (custom emoji)
  name      String // t.me/addstickers/<name> (or addemoji for custom emoji)
  title     String
  createdAt DateTime @default(now())

  @@id([userId, kind])
}

/// Per-owner block list for musaraha senders.
model MusarahaBlock {
  ownerId   BigInt
  senderId  BigInt
  createdAt DateTime @default(now())

  @@id([ownerId, senderId])
}

/// Countdown events: the bot counts down and announces on the day.
model CountdownEvent {
  id        Int      @id @default(autoincrement())
  chatId    BigInt
  name      String
  targetAt  DateTime // UTC midnight of the event day
  announced Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([chatId])
}

/// Support tickets (complaints/suggestions) opened by members for admins.
model Ticket {
  id        Int      @id @default(autoincrement())
  chatId    BigInt
  userId    BigInt
  userName  String?
  message   String
  status    String   @default("open") // open | closed
  reply     String?
  createdAt DateTime @default(now())

  @@index([chatId, status])
}

/// Audit trail of actions performed through the owner dashboard.
model DashboardAudit {
  id        Int      @id @default(autoincrement())
  actorId   BigInt
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Unlocked achievements per member.
model Achievement {
  id         Int      @id @default(autoincrement())
  chatId     BigInt
  userId     BigInt
  code       String
  unlockedAt DateTime @default(now())

  @@unique([chatId, userId, code])
  @@index([chatId, userId])
}

/// Items a member bought from the shop (titles / perks).
model ShopPurchase {
  id        Int      @id @default(autoincrement())
  chatId    BigInt
  userId    BigInt
  itemId    String
  createdAt DateTime @default(now())

  @@unique([chatId, userId, itemId])
  @@index([chatId, userId])
}

/// Daily mission progress (resets per calendar day).
model MissionProgress {
  id              Int     @id @default(autoincrement())
  chatId          BigInt
  userId          BigInt
  day             String  // YYYY-MM-DD
  messages        Int     @default(0)
  games           Int     @default(0)
  claimedMessages Boolean @default(false)
  claimedGames    Boolean @default(false)

  @@unique([chatId, userId, day])
  @@index([chatId, userId])
}

/// Daily scheduled messages (sent when server time matches HH:MM).
model ScheduledMessage {
  id        Int      @id @default(autoincrement())
  chatId    BigInt
  text      String
  time      String   // "HH:MM" 24h
  enabled   Boolean  @default(true)
  lastSent  String?  // last YYYY-MM-DD it fired (dedupe)
  createdBy BigInt
  createdAt DateTime @default(now())

  @@index([chatId])
  @@index([enabled])
}

/// Cache of downloaded YouTube audio: reuse Telegram file_id so a song is
/// fetched from YouTube once, then re-sent instantly across all chats.
model AudioCache {
  id        Int      @id @default(autoincrement())
  videoId   String   @unique
  fileId    String
  title     String
  duration  Int?
  hits      Int      @default(0)
  createdAt DateTime @default(now())

  @@index([videoId])
}

/// Audit log of moderation/admin actions for accountability.
model AuditLog {
  id        Int      @id @default(autoincrement())
  chatId    BigInt
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  action    String
  actorId   BigInt
  targetId  BigInt?
  details   String?
  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
}

/// Virtual pet per member (fun feature). Stats decay over time; computed on read.
model Pet {
  id          Int      @id @default(autoincrement())
  chatId      BigInt
  userId      BigInt

  name        String   @default("حيوان")
  species     String   @default("🐶")
  level       Int      @default(1)
  xp          Int      @default(0)
  hunger      Int      @default(80) // 0 (starving) .. 100 (full)
  happiness   Int      @default(80) // 0 (sad) .. 100 (joyful)
  lastFedAt   DateTime @default(now())
  lastPlayedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([chatId, userId])
}

/// A user's saved custom (premium) emoji, grabbed from any pack, so the bot can
/// resend them. Requires the bot owner to have Telegram Premium to actually send.
model SavedEmoji {
  userId    BigInt   @id
  items     String   @default("[]") // JSON array of { e: string, id: string }
  updatedAt DateTime @updatedAt
}
